<div class="diet-page">
    <!-- Header -->
    <div class="page-header">
        <h1 style="display:flex; align-items:center; gap:10px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
            Plano de Dieta
        </h1>
    </div>

    <!-- Plan Selector -->
    <div class="plan-selector-section">
        <label for="planSelect">Plano Ativo:</label>
        <div class="selector-row">
            <select id="planSelect" onchange="switchPlan(this.value)">
                <option value="">Selecione um plano...</option>
                <% allPlans.forEach(plan => { %>
                    <option value="<%= plan.id %>" data-template="<%= plan.isTemplate ? '1' : '0' %>" <%= (activePlan && plan.id === activePlan.id) ? 'selected' : '' %>>
                        <%= plan.name %> <%= plan.isTemplate ? '(Template)' : (plan.isActive ? '(Ativo)' : '') %>
                    </option>
                <% }); %>
            </select>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <button class="btn btn-success" onclick="createNewPlan()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Novo Plano
            </button>
            <% } %>
            <% if (typeof isAdmin !== 'undefined' && isAdmin && activePlan && activePlan.id) { %>
            <button class="btn btn-secondary btn-sm" id="btn-toggle-template" 
                    onclick="toggleDietTemplate(<%= activePlan.id %>, this)"
                    title="<%= activePlan.isTemplate ? 'Remover da Biblioteca' : 'Mover para Biblioteca' %>">
                <%= activePlan.isTemplate ? 'Na Biblioteca' : 'Tornar Template' %>
            </button>
            <% } %>
        </div>
    </div>

    <% if (activePlan && activePlan.id) { %>
        <!-- Daily Totals -->
        <div class="totals-card">
            <h2 style="display:flex; align-items:center; gap:8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Resumo Nutricional
            </h2>
            <div class="totals-grid">
                <div class="total-item">
                    <span class="label">Calorias</span>
                    <span class="value"><%= totals.totalCalories %> kcal</span>
                </div>
                <div class="total-item">
                    <span class="label">Proteína</span>
                    <span class="value"><%= totals.totalProtein.toFixed(1) %>g</span>
                </div>
                <div class="total-item">
                    <span class="label">Carboidratos</span>
                    <span class="value"><%= totals.totalCarbs.toFixed(1) %>g</span>
                </div>
                <div class="total-item">
                    <span class="label">Gordura</span>
                    <span class="value"><%= totals.totalFat.toFixed(1) %>g</span>
                </div>
            </div>
        </div>

        <!-- Meals section header -->
        <div class="section-card-header" style="margin-top:24px;">
            <div class="section-card-title">
                <span class="section-icon-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                </span>
                <h2>Refeições</h2>
            </div>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <button class="btn btn-sm btn-primary" onclick="showAddMealForm()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Adicionar Refeição
            </button>
            <% } %>
        </div>

        <!-- Add Meal Form (Hidden by default) -->
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="add-meal-form" id="addMealForm" style="display: none;">
            <h3>Adicionar Nova Refeição</h3>
            <form onsubmit="submitAddMeal(event)">
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>Nome da Refeição *</label>
                        <input type="text" id="mealName" placeholder="ex: Café da Manhã, Almoço, Lanche..." required>
                    </div>
                    <div class="form-group">
                        <label>Horário</label>
                        <input type="time" id="mealTime" placeholder="HH:MM">
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Criar Refeição
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="hideAddMealForm()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
        <% } %>

        <!-- Meals -->
        <div class="meals-container">
            <% if (activePlan.meals && activePlan.meals.length > 0) { %>
                <% activePlan.meals.forEach((meal, mealIndex) => { %>
                    <div class="meal-card">
                        <div class="meal-header">
                            <div class="meal-title">
                                <h3><%= meal.name %></h3>
                                <% if (meal.time) { %>
                                    <span class="meal-time" style="display:inline-flex; align-items:center; gap:4px;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <%= meal.time %>
                                    </span>
                                <% } %>
                            </div>
                            <div class="meal-header-actions">
                                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                <button class="btn btn-success btn-sm" onclick="toggleAddFoodForm(<%= meal.id %>)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    Alimento
                                </button>
                                <button class="btn-delete btn" onclick="deleteMeal(<%= meal.id %>)" title="Deletar refeição" aria-label="Deletar refeição">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                </button>
                                <% } %>
                            </div>
                        </div>

                        <div class="foods-section">
                            <% if (meal.foods && meal.foods.length > 0) { %>
                                <table class="foods-table">
                                    <thead>
                                        <tr>
                                            <th>Alimento</th>
                                            <th>Quantidade</th>
                                            <th>Calorias</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% meal.foods.forEach(food => { %>
                                            <tr data-food-id="<%= food.id %>" data-name="<%= food.name %>" data-quantity="<%= food.quantity || '' %>" data-notes="<%= food.notes || '' %>" data-calories="<%= food.calories || '' %>" data-protein="<%= food.protein || '' %>" data-carbs="<%= food.carbs || '' %>" data-fat="<%= food.fat || '' %>">
                                                <td>
                                                    <strong><%= food.name %></strong>
                                                    <% if (food.notes) { %>
                                                        <br><small class="food-notes"><%= food.notes %></small>
                                                    <% } %>
                                                    <% if (food.options && food.options.length > 0) { %>
                                                        <div class="food-options-list" id="food-options-<%= food.id %>">
                                                            <% food.options.forEach(opt => { %>
                                                                <span class="food-option-pill" data-option-id="<%= opt.id %>">
                                                                    ou <%= opt.name %><% if (opt.quantity) { %> (<%= opt.quantity %>)<% } %>
                                                                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                                                    <button type="button" class="food-option-remove" onclick="deleteFoodOption(<%= opt.id %>)" title="Remover substituto">&times;</button>
                                                                    <% } %>
                                                                </span>
                                                            <% }); %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="food-options-list" id="food-options-<%= food.id %>"></div>
                                                    <% } %>
                                                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                                    <button type="button" class="food-option-add-btn" onclick="toggleAddOptionForm(<%= food.id %>)">+ substituto</button>
                                                    <div class="food-option-form" id="option-form-<%= food.id %>" style="display:none;">
                                                        <input type="text" class="opt-name" placeholder="Nome (ex: Patinho)" maxlength="100">
                                                        <input type="text" class="opt-quantity" placeholder="Qtd (ex: 115g)" maxlength="50">
                                                        <input type="number" class="opt-calories" placeholder="kcal" step="0.01" min="0">
                                                        <input type="number" class="opt-protein" placeholder="prot(g)" step="0.1" min="0">
                                                        <input type="number" class="opt-carbs" placeholder="carbs(g)" step="0.1" min="0">
                                                        <input type="number" class="opt-fat" placeholder="gord(g)" step="0.1" min="0">
                                                        <div class="food-option-form-actions">
                                                            <button type="button" class="btn btn-primary btn-sm" onclick="submitAddOption(<%= food.id %>)">Adicionar</button>
                                                            <button type="button" class="btn btn-secondary btn-sm" onclick="toggleAddOptionForm(<%= food.id %>)">Cancelar</button>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                                </td>
                                                <td class="quantity-cell"><%= food.quantity %></td>
                                                <td><%= food.calories ? food.calories + ' kcal' : '—' %></td>
                                                <td>
                                                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                                    <div style="display:flex; gap:4px;">
                                                        <button class="btn-icon" onclick="editFood(<%= food.id %>)" title="Editar" aria-label="Editar alimento">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                        <button class="btn btn-delete btn-sm" onclick="deleteFood(<%= food.id %>)" title="Remover" aria-label="Remover alimento"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></button>
                                                    </div>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <p class="no-foods">Nenhum alimento adicionado a esta refeição</p>
                            <% } %>
                        </div>

                        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                        <div class="add-food-form" id="addFoodForm-<%= meal.id %>" style="display: none;">
                            <h4 style="display:flex; align-items:center; gap:8px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Adicionar Alimento
                            </h4>
                            <form onsubmit="addFood(event, <%= meal.id %>)">
                                <div class="form-row">
                                    <div class="form-group flex-2">
                                        <label>Nome * <span class="food-search-hint" style="display:inline-flex; align-items:center; gap:3px;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>busca automática</span></label>
                                        <div class="food-search-wrapper">
                                            <input type="text" class="food-name" placeholder="ex: Frango grelhado" required maxlength="100" autocomplete="off" oninput="onFoodNameInput(this)">
                                            <div class="food-autocomplete-dropdown" style="display:none;"></div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Qtd</label>
                                        <input type="text" class="food-quantity" placeholder="150" oninput="onQuantityInput(this)">
                                    </div>
                                    <div class="form-group">
                                        <label>Unidade</label>
                                        <select class="food-unit" onchange="onUnitChange(this)">
                                            <option value="g">g</option>
                                            <option value="ml">ml</option>
                                            <option value="un">un</option>
                                            <option value=" porção"> porção</option>
                                            <option value="">outro</option>
                                        </select>
                                        <small class="unit-hint" style="display:none;color:var(--text-tertiary);font-size:11px;">valores por 100g — ajuste manualmente</small>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Calorias (kcal)</label>
                                        <input type="number" class="food-calories" placeholder="0" min="0" step="0.01">
                                    </div>
                                    <div class="form-group">
                                        <label>Proteína (g)</label>
                                        <input type="number" class="food-protein" placeholder="0" min="0" step="0.1">
                                    </div>
                                    <div class="form-group">
                                        <label>Carbs (g)</label>
                                        <input type="number" class="food-carbs" placeholder="0" min="0" step="0.1">
                                    </div>
                                    <div class="form-group">
                                        <label>Gordura (g)</label>
                                        <input type="number" class="food-fat" placeholder="0" min="0" step="0.1">
                                    </div>
                                </div>
                                <div class="form-group" style="margin-bottom: 15px;">
                                    <label>Notas (opcional)</label>
                                    <input type="text" class="food-notes-input" placeholder="ex: Sem pele, cozido...">
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                        Adicionar
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="toggleAddFoodForm(<%= meal.id %>)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        Cancelar
                                    </button>
                                </div>
                            </form>
                        </div>
                        <% } %>

                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <p>Nenhuma refeição adicionada ainda ao plano "<%= activePlan.name %>"</p>
                    <p>Use o botão acima para criar uma nova refeição.</p>
                </div>
            <% } %>
        </div>

    <% } else { %>
        <div class="empty-state">
            <p>Nenhum plano de dieta selecionado</p>
            <button class="btn btn-primary btn-lg" onclick="createNewPlan()">Criar Plano de Dieta</button>
        </div>
    <% } %>
</div>

<style>
.food-search-hint {
    font-size: 11px;
    font-weight: 400;
    color: var(--text-tertiary);
    margin-left: 6px;
}

.food-search-wrapper {
    position: relative;
}

.food-autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-tertiary);
    border: 1px solid var(--accent-primary);
    border-top: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    z-index: 1000;
    max-height: 280px;
    overflow-y: auto;
    box-shadow: var(--shadow-md);
}

.food-autocomplete-item {
    padding: 10px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--border-default);
    transition: background 120ms;
}

.food-autocomplete-item:last-child {
    border-bottom: none;
}

.food-autocomplete-item:hover {
    background: var(--bg-hover);
}

.food-autocomplete-name {
    font-weight: 600;
    font-size: 13px;
    color: var(--text-primary);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.food-autocomplete-macros {
    font-size: 11px;
    color: var(--text-tertiary);
}

.food-autocomplete-macros span {
    margin-right: 10px;
}

.food-autocomplete-macros .kcal {
    color: var(--accent-primary);
    font-weight: 600;
}

.food-autocomplete-source {
    font-size: 10px;
    color: var(--text-tertiary);
    float: right;
}

.food-autocomplete-loading,
.food-autocomplete-empty {
    padding: 12px 14px;
    font-size: 13px;
    color: var(--text-tertiary);
    text-align: center;
}

.diet-page {
    max-width: 1200px;
    margin: 0 auto;
}

.plan-selector-section {
    background: var(--bg-card);
    padding: 20px;
    border-radius: var(--radius-lg);
    margin-bottom: 28px;
    border: 1px solid var(--border-default);
}

.plan-selector-section label {
    display: block;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--text-primary);
}

.selector-row {
    display: flex;
    gap: 10px;
}

.selector-row select {
    flex: 1;
    padding: 9px 13px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-family: inherit;
    background: var(--bg-tertiary);
    color: var(--text-primary);
}

.selector-row select:focus {
    outline: none;
    border-color: var(--accent-primary);
}

.add-meal-form {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 20px;
    margin-bottom: 25px;
}

.add-meal-form h3 {
    margin-top: 0;
    color: var(--text-primary);
}

.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 15px;
    margin-bottom: 15px;
    width: 100%;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.flex-1 {
    grid-column: span 1;
}

.form-group.flex-2 {
    grid-column: span 2;
}

.form-group label {
    font-weight: 600;
    margin-bottom: 5px;
    color: var(--text-secondary);
    font-size: 13px;
}

.form-group input,
.form-group select {
    padding: 9px 13px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    background: var(--bg-tertiary);
    color: var(--text-primary);
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--border-focus, rgba(249, 115, 22, 0.15));
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.meals-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

@media (max-width: 700px) {
    .meals-container {
        grid-template-columns: 1fr;
    }
}

.meal-card {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

.meal-header {
    background: var(--accent-muted);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border-default);
    flex-wrap: wrap;
    gap: 10px;
}

.meal-header-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
}

.meal-title h3 {
    margin: 0 0 5px 0;
    color: var(--text-primary);
    font-size: 1.2rem;
}

.foods-section {
    padding: 15px 20px;
}

.foods-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
}

.foods-table thead {
    background: var(--bg-tertiary);
}

.foods-table th {
    padding: 10px;
    text-align: left;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 13px;
    border-bottom: 2px solid var(--border-default);
}

.foods-table td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-primary);
}

.foods-table tbody tr:hover {
    background: var(--bg-tertiary);
}

.quantity-cell {
    font-weight: 600;
    color: var(--accent-primary);
}

.food-notes {
    color: var(--text-secondary);
}

.food-options-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
}

.food-option-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 11px;
    padding: 2px 6px 2px 8px;
    border-radius: var(--radius-full);
}

.food-option-remove {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
    padding: 0 2px;
}
.food-option-remove:hover {
    color: var(--status-error);
}

.food-option-add-btn {
    display: inline-block;
    background: none;
    border: none;
    color: var(--accent-primary);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    margin-top: 6px;
}
.food-option-add-btn:hover {
    text-decoration: underline;
}

.food-option-form {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    padding: 10px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
}
.food-option-form input {
    flex: 1 1 90px;
    min-width: 70px;
    padding: 6px 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 12px;
}
.food-option-form-actions {
    display: flex;
    gap: 6px;
    width: 100%;
}

.no-foods {
    color: var(--text-secondary);
    text-align: center;
    padding: 20px;
    font-style: italic;
}

.add-food-form {
    background: var(--bg-tertiary);
    border-top: 2px dashed var(--border-default);
    padding: 20px;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
