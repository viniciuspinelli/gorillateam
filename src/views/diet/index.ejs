}

.add-food-form h4 {
    margin-top: 0;
    color: var(--text-primary);
    margin-bottom: 15px;
}

@media (max-width: 768px) {
    .meal-header {
        flex-direction: column;
        gap: 10px;
    }

    .form-row {
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 10px;
    }

    .form-group.flex-2 {
        grid-column: span 1;
    }

    .foods-table {
        font-size: 13px;
    }

    .foods-table th,
    .foods-table td {
