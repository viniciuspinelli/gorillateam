<div class="admin-page">
    <div class="page-header" style="display:flex; align-items:center; gap:14px; border-bottom:1px solid var(--border-subtle);">
        <span style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-muted); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <div>
            <h1 style="margin-bottom:2px;">Meu Perfil</h1>
            <p class="page-subtitle">Gerencie seus dados de acesso</p>
        </div>
    </div>

    <% if (success) { %>
        <div class="alert alert-success" style="margin-bottom:16px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <%= success %>
        </div>
    <% } %>

    <% if (error) { %>
        <div class="alert alert-error" style="margin-bottom:16px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <%= error %>
        </div>
    <% } %>

    <form method="POST" action="/profile" class="admin-form-card" style="max-width:520px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Dados Pessoais -->
        <div class="admin-section-header" style="margin-bottom:16px;">
            <h2 style="font-size:14px;font-weight:600;text-transform:uppercase;color:var(--text-tertiary);letter-spacing:.05em;">Dados Pessoais</h2>
        </div>

        <div class="form-group">
            <label class="form-label">Usuário</label>
            <input type="text" class="form-input" value="<%= profile.username %>" disabled style="opacity:.5;cursor:not-allowed;">
            <span style="font-size:11px;color:var(--text-tertiary);margin-top:4px;display:block;">O nome de usuário não pode ser alterado.</span>
        </div>

        <div class="form-group">
            <label class="form-label" for="fullName">Nome Completo</label>
            <input type="text" id="fullName" name="fullName" class="form-input"
                value="<%= profile.fullName || '' %>" placeholder="Seu nome completo" maxlength="100">
        </div>

        <div class="form-group">
            <label class="form-label" for="email">E-mail</label>
            <input type="email" id="email" name="email" class="form-input"
                value="<%= profile.email || '' %>" placeholder="seu@email.com" required>
        </div>

        <!-- Alterar Senha -->
        <div class="admin-section-header" style="margin:24px 0 16px;">
            <h2 style="font-size:14px;font-weight:600;text-transform:uppercase;color:var(--text-tertiary);letter-spacing:.05em;">Alterar Senha <span style="font-weight:400;font-size:12px;">(opcional)</span></h2>
        </div>

        <div class="form-group">
            <label class="form-label" for="currentPassword">Senha Atual</label>
            <input type="password" id="currentPassword" name="currentPassword" class="form-input"
                placeholder="••••••••" autocomplete="current-password">
        </div>

        <div class="form-group">
            <label class="form-label" for="newPassword">Nova Senha</label>
            <input type="password" id="newPassword" name="newPassword" class="form-input"
                placeholder="Mínimo 8 caracteres" autocomplete="new-password" minlength="8">
        </div>

        <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirmar Nova Senha</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input"
                placeholder="••••••••" autocomplete="new-password">
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <a href="/workouts" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
