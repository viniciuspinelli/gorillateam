<!-- LANDING PAGE — GORILLA.TEAM -->
<div class="lp-wrap">

    <!-- FAIXA DE PILARES -->
    <div class="lp-pillars-bar" aria-label="Pilares do time">
        <span>Força</span><i aria-hidden="true">|</i><span>Disciplina</span><i aria-hidden="true">|</i><span>Foco</span><i aria-hidden="true">|</i><span>União</span>
    </div>

    <!-- NAV -->
    <nav class="lp-nav">
        <a href="/" class="lp-nav-logo">
            <img src="/brand/mascot.png" alt="" class="lp-nav-mascot">
            <img src="/brand/wordmark.png" alt="Gorilla.Team" class="lp-nav-logo-img">
        </a>
        <a href="/auth/login" class="lp-nav-login">Entrar</a>
    </nav>

    <!-- HERO -->
    <section class="lp-hero">
        <div class="lp-hero-mascot-wrap">
            <img src="/brand/mascot.png" alt="Mascote Gorilla.Team" class="lp-hero-mascot">
        </div>
        <h1 class="lp-hero-wordmark">
            <img src="/brand/wordmark.png" alt="Gorilla.Team">
        </h1>
        <p class="lp-tagline">Mais que atletas, <span>uma família.</span></p>

        <div class="lp-manifesto">
            <p class="lp-m1">Uma mentalidade.</p>
            <p class="lp-m2">Um propósito.</p>
            <p class="lp-m3">Um time.</p>
        </div>

        <div class="lp-hero-cta">
            <a href="/auth/login" class="lp-btn-enter">
                Entrar no time
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <p class="lp-hero-note">Acesso exclusivo para atletas do Gorilla.Team</p>
        </div>
    </section>

    <!-- CONQUISTAS -->
    <section class="lp-podium">
        <div class="lp-podium-bg" aria-hidden="true"></div>
        <div class="lp-podium-inner">
            <h2 class="lp-title lp-title-center"><span class="lp-t-white">Nossas</span> <span class="lp-t-orange">conquistas</span></h2>
            <div class="lp-stripe lp-stripe-center" aria-hidden="true"></div>
            <figure class="lp-podium-figure">
                <img src="/brand/photo-podium.jpg" alt="Atletas do Gorilla.Team no palco da FBBF com troféus e medalhas" loading="lazy">
            </figure>
            <p class="lp-podium-caption">Time Gorilla no pódio da <strong class="lp-purple">FBBF</strong> — Federação Brasileira Bodybuilding Fitness.</p>
        </div>
    </section>

    <!-- QUEM SOMOS -->
    <section class="lp-split">
        <div class="lp-split-text">
            <h2 class="lp-title"><span class="lp-t-white">Quem</span> <span class="lp-t-orange">somos?</span></h2>
            <div class="lp-stripe" aria-hidden="true"></div>
            <p class="lp-body">
                O <strong class="lp-orange">GORILLA.TEAM</strong> nasceu da união de atletas que compartilham mais que treinos:
                compartilhamos <strong class="lp-purple">propósitos, valores e a vontade de ser melhor todos os dias.</strong>
            </p>
            <div class="lp-pillars">
                <div class="lp-pillar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="lp-ic-orange"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
                    <strong>Foco</strong><span>no objetivo</span>
                </div>
                <div class="lp-pillar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="lp-ic-purple"><path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/></svg>
                    <strong>Disciplina</strong><span>na rotina</span>
                </div>
                <div class="lp-pillar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="lp-ic-orange"><path d="M7 20c-2-3-3-7-1-11 1-2 3-3 4-5 1 2 0 4 2 5 3 1 6 0 7 3 1 4-2 8-6 8H7z"/></svg>
                    <strong>Força</strong><span>para evoluir</span>
                </div>
                <div class="lp-pillar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="lp-ic-purple"><circle cx="12" cy="7" r="3"/><circle cx="5" cy="9" r="2.2"/><circle cx="19" cy="9" r="2.2"/><path d="M6 20v-2a6 6 0 0 1 12 0v2M1.5 19v-1a3.5 3.5 0 0 1 4-3.5M22.5 19v-1a3.5 3.5 0 0 0-4-3.5"/></svg>
                    <strong>União</strong><span>para vencer</span>
                </div>
            </div>
        </div>
        <div class="lp-split-photo">
            <img src="/brand/photo-gorilla.jpg" alt="" loading="lazy">
        </div>
    </section>

    <!-- NOSSA MISSÃO -->
    <section class="lp-split lp-split-reverse">
        <div class="lp-split-text">
            <h2 class="lp-title"><span class="lp-t-white">Nossa</span> <span class="lp-t-orange">missão</span></h2>
            <div class="lp-stripe" aria-hidden="true"></div>
            <p class="lp-body">
                Inspirar, evoluir e transformar através da <strong class="lp-orange">disciplina</strong> e do
                <strong class="lp-orange">trabalho duro</strong>, dentro e fora do esporte.
            </p>
            <p class="lp-body">Mais que resultados, buscamos <strong class="lp-purple">LEGADO</strong>.</p>
            <p class="lp-slogan">
                <span class="lp-t-white">Mentes</span>
                <span class="lp-t-orange">fortes,</span>
                <span class="lp-t-white">corpos</span>
                <span class="lp-t-purple">inquebráveis.</span>
            </p>
        </div>
        <div class="lp-split-photo">
            <img src="/brand/photo-athlete.jpg" alt="" loading="lazy">
        </div>
    </section>

    <!-- NOSSOS VALORES -->
    <section class="lp-values">
        <h2 class="lp-title lp-title-center"><span class="lp-t-white">Nossos</span> <span class="lp-t-orange">valores</span></h2>
        <div class="lp-stripe lp-stripe-center" aria-hidden="true"></div>
        <div class="lp-values-grid">
            <div class="lp-value">
                <h3 class="lp-orange">Disciplina</h3>
                <p>Foco no que nos mantém firmes e consistentes na evolução.</p>
            </div>
            <div class="lp-value">
                <h3 class="lp-purple">Respeito</h3>
                <p>Respeitamos o próximo, o processo e o ambiente. Aqui, todos crescem juntos.</p>
            </div>
            <div class="lp-value">
                <h3 class="lp-orange">União</h3>
                <p>Sozinhos somos fortes, juntos somos imbatíveis.</p>
            </div>
            <div class="lp-value">
                <h3 class="lp-purple">Evolução</h3>
                <p>Não buscamos ser os melhores de ontem, e sim melhores a cada dia.</p>
            </div>
            <div class="lp-value">
                <h3 class="lp-orange">Propósito</h3>
                <p>Viver por algo maior: transformar vidas através do esporte e da mentalidade.</p>
            </div>
        </div>
    </section>

    <!-- PLATAFORMA -->
    <section class="lp-features">
        <h2 class="lp-title lp-title-center"><span class="lp-t-white">Sua</span> <span class="lp-t-orange">plataforma</span></h2>
        <div class="lp-stripe lp-stripe-center" aria-hidden="true"></div>
        <p class="lp-section-sub">Tudo o que o atleta do time precisa, montado pelo treinador, na palma da mão.</p>
        <div class="lp-features-grid">
            <div class="lp-feature-card">
                <div class="lp-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/></svg></div>
                <h3>Treinos por grupo muscular</h3>
                <p>Planos montados pelo treinador, com séries, repetições, cargas e histórico de cada sessão.</p>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon lp-feature-icon-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 2a10 10 0 0 1 10 10"/></svg></div>
                <h3>Dieta e macros</h3>
                <p>Refeições, substitutos e macros calculados em tempo real conforme a dieta é ajustada.</p>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
                <h3>Evolução do shape</h3>
                <p>Peso e fotos de progresso registrados para acompanhar cada fase da preparação.</p>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon lp-feature-icon-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></div>
                <h3>Lista de compras</h3>
                <p>Gerada a partir da dieta, com as quantidades da semana calculadas automaticamente.</p>
            </div>
        </div>
    </section>

    <!-- CTA FINAL -->
    <section class="lp-cta-section">
        <div class="lp-cta-photo" aria-hidden="true"></div>
        <div class="lp-cta-inner">
            <h2 class="lp-title lp-title-center"><span class="lp-t-white">Este é</span> <span class="lp-t-orange">só o começo.</span></h2>
            <div class="lp-stripe lp-stripe-center" aria-hidden="true"></div>
            <p class="lp-body lp-center">
                O <strong class="lp-orange">GORILLA.TEAM</strong> é mais que um time. É uma família que treina, se apoia e vence junto.
            </p>
            <p class="lp-welcome">Seja bem-vindo ao nosso mundo.</p>
            <a href="/auth/login" class="lp-btn-enter">
                Entrar
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="lp-footer">
        <img src="/brand/wordmark.png" alt="Gorilla.Team" class="lp-footer-logo">
        <p class="lp-tagline lp-tagline-sm">Mais que atletas, <span>uma família.</span></p>
        <p class="lp-copy">© <%= new Date().getFullYear() %> Gorilla.Team · Todos os direitos reservados</p>
    </footer>
</div>

<style>
    .lp-wrap {
        --lp-orange: var(--accent-primary);
        --lp-purple: var(--accent-secondary);
        --lp-purple-text: var(--accent-secondary-light);
        --lp-silver: var(--brand-silver);
        --lp-line: var(--border-default);
        color: var(--text-primary);
        font-family: var(--font-body);
        overflow-x: hidden;
    }

    /* ---------- tipografia compartilhada ---------- */
    .lp-title {
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 900;
        text-transform: uppercase;
        font-size: clamp(40px, 7vw, 68px);
        line-height: 0.92;
        letter-spacing: 0;
    }

    .lp-title-center { text-align: center; }
    .lp-t-white { color: var(--lp-silver); }
    .lp-t-orange { color: var(--lp-orange); }
    .lp-t-purple { color: var(--lp-purple-text); }
    .lp-orange { color: var(--lp-orange); }
    .lp-purple { color: var(--lp-purple-text); }

    .lp-title .lp-t-white,
    .lp-title .lp-t-orange { display: inline-block; }

    .lp-stripe {
        width: 92px;
        height: 4px;
        margin: 18px 0 22px;
        background: linear-gradient(to right, var(--lp-orange) 0 55%, transparent 55% 62%, var(--lp-purple) 62% 100%);
    }

    .lp-stripe-center { margin-left: auto; margin-right: auto; }

    .lp-body {
        font-size: 18px;
        line-height: 1.55;
        color: var(--text-primary);
        max-width: 520px;
        margin-bottom: 16px;
    }

    .lp-body strong { font-weight: 700; }
    .lp-center { text-align: center; margin-left: auto; margin-right: auto; }

    .lp-tagline {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(13px, 2.2vw, 18px);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--lp-silver);
        text-align: center;
    }

    .lp-tagline span { color: var(--lp-orange); }

    /* ---------- faixa de pilares ---------- */
    .lp-pillars-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px 22px;
        padding: 12px 16px;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--lp-silver);
        border-bottom: 1px solid var(--lp-line);
    }

    .lp-pillars-bar i {
        font-style: normal;
        color: var(--lp-orange);
        letter-spacing: 0;
    }

    /* ---------- nav ---------- */
    .lp-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1180px;
        margin: 0 auto;
        padding: 16px 24px;
    }

    .lp-nav-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }

    .lp-nav-mascot {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--lp-orange);
        box-shadow: 0 0 0 2px var(--bg-primary), 0 0 0 3px var(--lp-purple);
    }

    .lp-nav-logo-img { height: 22px; width: auto; }

    .lp-nav-login {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        padding: 8px 20px;
        border: 1px solid var(--lp-purple);
        border-radius: 6px;
        transition: background 200ms, border-color 200ms;
    }

    .lp-nav-login:hover {
        background: var(--accent-secondary-muted);
        border-color: var(--accent-secondary-hover);
    }

    /* ---------- hero ---------- */
    .lp-hero {
        position: relative;
        text-align: center;
        padding: 40px 20px 90px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .lp-hero::before {
        content: '';
        position: absolute;
        inset: -40px -20vw -120px;
        -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent);
        mask-image: linear-gradient(to bottom, black 55%, transparent);
        z-index: -1;
        background:
            radial-gradient(ellipse 40% 50% at 15% 35%, rgba(242, 74, 0, 0.28), transparent 70%),
            radial-gradient(ellipse 40% 50% at 85% 35%, rgba(106, 27, 214, 0.32), transparent 70%);
        pointer-events: none;
    }

    .lp-hero-mascot-wrap {
        display: inline-block;
        border-radius: 50%;
        padding: 5px;
        background: linear-gradient(135deg, var(--lp-orange), var(--lp-purple));
        box-shadow: 0 0 80px -10px rgba(242, 74, 0, 0.55), 0 0 90px -10px rgba(106, 27, 214, 0.5);
        margin-bottom: 26px;
    }

    .lp-hero-mascot {
        display: block;
        width: clamp(150px, 26vw, 220px);
        height: clamp(150px, 26vw, 220px);
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--bg-primary);
    }

    .lp-hero-wordmark {
        margin: 0 auto 14px;
        max-width: 760px;
        line-height: 0;
    }

    .lp-hero-wordmark img {
        width: 100%;
        height: auto;
        filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.6));
    }

    .lp-manifesto {
        display: inline-block;
        margin: 40px auto 36px;
        padding: 22px 40px;
        border: 1px solid transparent;
        border-image: linear-gradient(to right, var(--lp-orange), var(--lp-purple)) 1;
        background: rgba(5, 4, 7, 0.6);
    }

    .lp-manifesto p {
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 800;
        font-size: clamp(24px, 4vw, 34px);
        line-height: 1.12;
        text-transform: uppercase;
    }

    .lp-m1 { color: var(--lp-silver); }
    .lp-m2 { color: var(--lp-orange); }
    .lp-m3 { color: var(--lp-purple-text); }

    .lp-hero-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .lp-btn-enter {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 40px;
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 800;
        font-size: 20px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, #D44000, #B33600);
        border-radius: 6px;
        clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
        box-shadow: 0 10px 40px -10px rgba(242, 74, 0, 0.8);
        transition: transform 200ms, filter 200ms;
    }

    .lp-btn-enter:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .lp-hero-note {
        font-size: 13px;
        color: var(--text-tertiary);
    }

    /* ---------- conquistas (foto com bordas esfumaçadas) ---------- */
    .lp-podium {
        position: relative;
        overflow: hidden;
        padding: 80px 24px 90px;
        border-top: 1px solid var(--lp-line);
    }

    /* mesma foto, desfocada e escura, como atmosfera de fundo que some nas bordas */
    .lp-podium-bg {
        position: absolute;
        inset: -40px;
        background: url('/brand/photo-podium.jpg') center / cover no-repeat;
        filter: blur(50px) saturate(1.2);
        opacity: 0.16;
        -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
        mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
    }

    .lp-podium-inner {
        position: relative;
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
    }

    .lp-podium-figure {
        position: relative;
        max-width: 640px;
        margin: -10px auto -30px;
    }

    .lp-podium-figure::before {
        content: '';
        position: absolute;
        inset: 12% 8%;
        z-index: -1;
        background: radial-gradient(ellipse at 30% 50%, rgba(242, 74, 0, 0.45), transparent 65%),
                    radial-gradient(ellipse at 70% 50%, rgba(106, 27, 214, 0.55), transparent 65%);
        filter: blur(50px);
    }

    .lp-podium-figure img {
        display: block;
        width: 100%;
        height: auto;
        /* fade largo nas quatro bordas: a foto "nasce" do fundo preto e se dissolve nas bordas */
        -webkit-mask-image:
            linear-gradient(to bottom, transparent 0, rgba(0,0,0,0.6) 8%, black 20%, black 70%, rgba(0,0,0,0.5) 86%, transparent 100%),
            linear-gradient(to right, transparent 0, rgba(0,0,0,0.6) 7%, black 20%, black 80%, rgba(0,0,0,0.6) 93%, transparent 100%);
        -webkit-mask-composite: source-in;
        mask-image:
            linear-gradient(to bottom, transparent 0, rgba(0,0,0,0.6) 8%, black 20%, black 70%, rgba(0,0,0,0.5) 86%, transparent 100%),
            linear-gradient(to right, transparent 0, rgba(0,0,0,0.6) 7%, black 20%, black 80%, rgba(0,0,0,0.6) 93%, transparent 100%);
        mask-composite: intersect;
    }

    .lp-podium-caption {
        margin-top: 4px;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-secondary);
    }

    /* fade in ao entrar na tela e fade out ao sair (rolagem), sem JavaScript */
    @supports (animation-timeline: view()) {
        .lp-podium-figure {
            animation: lp-podium-fade linear both;
            animation-timeline: view();
            animation-range: entry 0% exit 100%;
        }

        @keyframes lp-podium-fade {
            0%   { opacity: 0; transform: translateY(40px) scale(0.96); filter: blur(6px); }
            30%  { opacity: 1; transform: none; filter: none; }
            75%  { opacity: 1; transform: none; filter: none; }
            100% { opacity: 0; transform: translateY(-30px) scale(0.98); filter: blur(4px); }
        }
    }

    /* navegadores sem scroll-timeline: fade in simples ao carregar */
    @supports not (animation-timeline: view()) {
        .lp-podium-figure { animation: lp-podium-in 1.4s ease-out both; }
        @keyframes lp-podium-in {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: none; }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .lp-podium-figure { animation: none !important; }
    }

    /* ---------- blocos com foto ---------- */
    .lp-split {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 48px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 80px 24px;
        border-top: 1px solid var(--lp-line);
    }

    .lp-split-reverse .lp-split-text { order: 2; }
    .lp-split-reverse .lp-split-photo { order: 1; }

    .lp-split-photo {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        max-height: 600px;
        border: 1px solid var(--lp-line);
    }

    .lp-split-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* pincelada laranja/roxa no rodapé da foto, como nas artes */
    .lp-split-photo::after {
        content: '';
        position: absolute;
        left: -10%;
        right: -10%;
        bottom: -30px;
        height: 90px;
        background: linear-gradient(100deg, transparent 0 8%, var(--lp-purple) 8% 45%, transparent 45% 52%, var(--lp-orange) 52% 92%, transparent 92%);
        transform: rotate(-6deg);
        filter: blur(1px);
