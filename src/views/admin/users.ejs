<div class="admin-page">
    <div class="page-header" style="display:flex; align-items:center; gap:14px; border-bottom:1px solid var(--border-subtle);">
        <span style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-muted); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <div style="flex:1;">
            <h1 style="margin-bottom:2px;"><% if (isAdmin) { %>Gerenciar Alunos<% } else { %>Meus Alunos<% } %></h1>
            <p class="page-subtitle"><%= users.length %> aluno(s) cadastrado(s)</p>
        </div>
        <a href="/admin/users/new" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo Aluno
        </a>
    </div>

    <div class="invite-link-card">
        <div class="invite-link-header">
            <span class="section-icon-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </span>
            <div>
                <div class="invite-link-title">Link de Convite</div>
                <div class="invite-link-desc">Envie para um aluno se cadastrar já vinculado a você — só admins e instrutores podem criar contas.</div>
            </div>
        </div>
        <div class="invite-link-row">
            <input type="text" id="inviteLinkInput" class="invite-link-input" value="<%= inviteLink %>" readonly onclick="this.select()">
            <button class="btn btn-sm btn-secondary" id="btn-copy-invite" onclick="copyInviteLink()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copiar
            </button>
        </div>
        <button type="button" class="btn-text-link" id="btn-regen-invite" onclick="regenerateInviteLink()">Gerar novo link (invalida o link anterior)</button>
    </div>

    <div class="admin-users-list">
        <% users.forEach(u => { %>
            <div class="admin-user-row">
                <span class="admin-user-avatar"><%= u.username.charAt(0).toUpperCase() %></span>
                <div class="admin-user-info">
                    <span class="admin-user-name">
                        <%= u.fullName || u.username %>
                        <% if (u.fullName) { %><small style="font-weight:400;color:var(--text-secondary);margin-left:6px;">@<%= u.username %></small><% } %>
                    </span>
                    <div style="display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin-top:6px;">
                        <span class="role-badge <%= u.role === 'admin' ? 'role-badge-admin' : '' %>">
                            <% if (u.role === 'admin') { %>
                                <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Admin
                            <% } else if (u.role === 'instructor') { %>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>Instrutor
                            <% } else { %>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Aluno
                            <% } %>
                        </span>
                        <% if (isAdmin && u.instructorUsername) { %>
                            <span class="role-badge">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><circle cx="7" cy="7" r="1.5"/></svg>
                                <%= u.instructorFullName || u.instructorUsername %>
                            </span>
                        <% } %>
                    </div>
                </div>
                <div class="admin-user-actions">
                    <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-secondary">Planos</a>
                    <details class="row-menu">
                        <summary class="btn btn-sm btn-secondary row-menu-trigger" aria-label="Mais ações de <%= u.username %>">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
                        </summary>
                        <div class="row-menu-panel">
                            <a href="/admin/users/<%= u.id %>/evolution">Evolução</a>
                            <% if (isAdmin || u.id !== user.id) { %>
                            <a href="/admin/users/<%= u.id %>/edit">Editar</a>
                            <% } %>
                            <% if (u.id !== user.id) { %>
                            <button type="button" class="row-menu-danger js-delete-user" data-id="<%= u.id %>" data-username="<%= u.username %>">Excluir usuário</button>
                            <% } %>
                        </div>
                    </details>
                </div>
            </div>
        <% }); %>

        <% if (users.length === 0) { %>
            <div class="empty-state">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block; margin:0 auto 14px; opacity:0.5;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <p>Nenhum aluno cadastrado ainda.</p>
                <a href="/admin/users/new" class="btn btn-primary">Criar primeiro aluno</a>
            </div>
        <% } %>
    </div>
</div>

<script nonce="<%= nonce %>">
function copyInviteLink() {
    const input = document.getElementById('inviteLinkInput');
    input.select();
    navigator.clipboard.writeText(input.value).then(function() {
        showToast('Link copiado!', 'success');
    }).catch(function() {
        document.execCommand('copy');
        showToast('Link copiado!', 'success');
    });
}

async function regenerateInviteLink() {
    if (!(await askConfirm('Gerar um novo link? O link atual deixará de funcionar.'))) return;
    try {
        const res = await fetch('/admin/users/invite-link/regenerate', {
            method: 'POST',
            headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById('inviteLinkInput').value = data.inviteLink;
            showToast('Novo link gerado!', 'success');
        } else {
            showToast(data.message || 'Erro ao gerar link', 'error');
        }
    } catch (_) {
        showToast('Erro de conexão', 'error');
    }
}

document.querySelectorAll('.js-delete-user').forEach(function(btn) {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        const username = this.dataset.username;
        this.closest('details')?.removeAttribute('open');
        if (!(await askConfirm(`Deletar o usuário "${username}"? Todos os dados serão removidos.`))) return;
        fetch(`/admin/users/${id}`, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                showToast(`Usuário ${username} removido`, 'success');
                setTimeout(function() { location.reload(); }, 800);
            } else {
                showToast(data.message || 'Erro ao deletar', 'error');
            }
        });
    });
});
</script>
