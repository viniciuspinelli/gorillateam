<div class="admin-page">
    <div class="page-header">
        <div>
            <a href="/admin/users" class="btn-back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Voltar</a>
            <h1 style="display:flex; align-items:center; gap:10px;">
                <% if (editUser) { %>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                    Editar Usuário
                <% } else { %>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    Novo Aluno
                <% } %>
            </h1>
        </div>
    </div>

    <% if (error) { %>
        <div class="alert alert-error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <%= error %>
        </div>
    <% } %>

    <div class="admin-form-card">
        <form method="POST" action="/admin/users/<%= editUser ? editUser.id + '/edit' : 'new' %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-field">
                <label for="username">Nome de usuário</label>
                <input type="text" id="username" name="username" autocapitalize="none" autocorrect="off" spellcheck="false"
                    value="<%= editUser ? editUser.username : '' %>"
                    placeholder="ex: joao" required>
            </div>

            <div class="form-field">
                <label for="fullName">Nome completo</label>
                <input type="text" id="fullName" name="fullName"
                    value="<%= editUser ? (editUser.fullName || '') : '' %>"
                    placeholder="ex: João da Silva">
            </div>

            <div class="form-field">
                <label for="email">E-mail <span class="field-hint">(para recuperação de senha)</span></label>
                <input type="email" id="email" name="email"
                    value="<%= editUser ? (editUser.email || '') : '' %>"
                    placeholder="aluno@email.com" required>
            </div>

            <div class="form-field">
                <label for="password">
                    Senha <%- editUser ? '<span class="field-hint">(deixe em branco para não alterar)</span>' : '' %>
                </label>
                <input type="password" id="password" name="password"
                    placeholder="••••••••"
                    <%= editUser ? '' : 'required' %>>
            </div>

            <div class="form-field">
                <label for="role">Nível de acesso</label>
                <select id="role" name="role">
                    <option value="user" <%= !editUser || editUser.role === 'user' ? 'selected' : '' %>>Aluno</option>
                    <% if (isAdmin) { %>
                    <option value="instructor" <%= editUser && editUser.role === 'instructor' ? 'selected' : '' %>>Instrutor</option>
                    <option value="admin" <%= editUser && editUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    <% } %>
                </select>
            </div>

            <% if (isAdmin && instructors && instructors.length > 0) { %>
            <div class="form-field">
                <label for="instructorId">Instrutor responsável <span class="field-hint">(opcional)</span></label>
                <select id="instructorId" name="instructorId">
                    <option value="">-- Nenhum --</option>
                    <% instructors.forEach(function(inst) { %>
                    <option value="<%= inst.id %>" <%= editUser && editUser.instructorId === inst.id ? 'selected' : '' %>>
                        <%= inst.fullName || inst.username %>
                    </option>
                    <% }); %>
                </select>
            </div>
            <% } %>

            <div class="form-actions">
                <a href="/admin/users" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <%= editUser ? 'Salvar Alterações' : 'Criar Aluno' %>
                </button>
            </div>
        </form>
    </div>
</div>
