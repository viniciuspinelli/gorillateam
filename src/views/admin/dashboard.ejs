<div class="admin-page">
    <div class="page-header" style="display:flex; align-items:center; gap:14px; border-bottom:1px solid var(--border-subtle);">
        <span style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-muted); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent-primary)" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        <div>
            <h1 style="margin-bottom:2px;"><% if (isAdmin) { %>Painel Admin<% } else { %>Painel Instrutor<% } %></h1>
            <p class="page-subtitle">Bem-vindo, <%= user.username %></p>
        </div>
    </div>

    <div class="admin-stats-grid">
        <div class="admin-stat-card is-primary">
            <div class="admin-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Alunos
            </div>
            <span class="admin-stat-value"><%= stats.users %></span>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
                Treinos na Biblioteca
            </div>
            <span class="admin-stat-value"><%= stats.workoutTemplates %></span>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
                Dietas na Biblioteca
            </div>
            <span class="admin-stat-value"><%= stats.dietTemplates %></span>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                Treinos Realizados
            </div>
            <span class="admin-stat-value"><%= stats.sessions %></span>
        </div>
    </div>

    <div class="admin-quick-actions">
        <h2 class="section-title" style="margin-top:0;">Acesso Rápido</h2>
        <div class="admin-action-grid">
            <a href="/admin/users" class="admin-action-featured">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <div>
                    <div class="admin-action-label">Gerenciar Alunos</div>
                    <div class="admin-action-desc">Criar, editar e atribuir treinos e dietas aos seus alunos</div>
                </div>
            </a>
            <div class="admin-action-list">
                <a href="/admin/users/new" class="admin-action-card">
                    <span class="admin-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg></span>
                    <span class="admin-action-text">
                        <span class="admin-action-label">Novo Aluno</span>
                        <span class="admin-action-desc">Cadastrar um novo usuário</span>
                    </span>
                    <svg class="admin-action-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a href="/admin/templates" class="admin-action-card">
                    <span class="admin-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
                    <span class="admin-action-text">
                        <span class="admin-action-label">Biblioteca de Planos</span>
                        <span class="admin-action-desc">Gerencie templates de treino e dieta</span>
                    </span>
                    <svg class="admin-action-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a href="/workouts/plans" class="admin-action-card">
                    <span class="admin-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg></span>
                    <span class="admin-action-text">
                        <span class="admin-action-label">Criar Treino Template</span>
                        <span class="admin-action-desc">Acesse o editor de treinos</span>
                    </span>
                    <svg class="admin-action-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>
    </div>
</div>
