<div class="active-workout-page">
    <!-- Workout Header -->
    <div class="workout-header">
        <h1><%= session.workoutPlan.groupName ? session.workoutPlan.name + ' · ' + session.workoutPlan.groupName : session.workoutPlan.name %></h1>
        <a href="/workouts" class="btn-back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Voltar</a>
    </div>

    <!-- Progress -->
    <div class="workout-controls">
        <div class="progress-bar-container">
            <div class="progress-label">
                <span id="progressText"><%= completedCount %>/<%= totalCount %> exercícios</span>
                <span class="progress-percent" id="progressPercent"><%= totalCount > 0 ? Math.round(completedCount / totalCount * 100) : 0 %>%</span>
            </div>
            <div class="progress-bar">
                <div id="progressFill" class="progress-fill" style="width: <%= totalCount > 0 ? (completedCount / totalCount * 100) : 0 %>%"></div>
            </div>
        </div>
    </div>

    <!-- Exercises List -->
    <div class="exercises-list">
        <% session.sessionExercises.forEach((sessionExercise, index) => { %>
            <div class="exercise-item <%= sessionExercise.isCompleted ? 'completed' : '' %>"
                 data-exercise-id="<%= sessionExercise.id %>">
                
                <div class="exercise-header">
                    <div class="exercise-number">
                        <span class="number"><%= index + 1 %></span>
                    </div>
                    <div class="exercise-info">
                        <h3><%= sessionExercise.exercise.name %></h3>
                        <div class="exercise-meta">
                            <span class="meta-item">
                                <strong><%= formatSetsReps(sessionExercise.exercise.sets, sessionExercise.exercise.reps) %></strong>
                            </span>
                            <% if (sessionExercise.exercise.weight) { %>
                                <span class="meta-item">
                                    <strong><%= sessionExercise.exercise.weight %></strong>
                                </span>
                            <% } %>
                            <% if (sessionExercise.exercise.restSeconds) { %>
                                <span class="meta-item" style="display:inline-flex; align-items:center; gap:4px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    <%= sessionExercise.exercise.restSeconds %>s descanso
                                </span>
                            <% } %>
                        </div>
                        <% if (sessionExercise.lastWeight || sessionExercise.lastReps) { %>
                            <p class="exercise-last-used">
                                Último: <strong><%= [sessionExercise.lastWeight, sessionExercise.lastReps].filter(Boolean).join(' · ') %></strong>
                            </p>
                        <% } %>
                        <% if (sessionExercise.exercise.notes) { %>
                            <p class="exercise-notes"><%= sessionExercise.exercise.notes %></p>
                        <% } %>
                        <% if (sessionExercise.actualWeight || sessionExercise.actualReps) { %>
                            <p class="exercise-load-done"><%= [sessionExercise.actualWeight, sessionExercise.actualReps].filter(Boolean).join(' · ') %></p>
                        <% } %>
                        <% if (sessionExercise.exercise.images && sessionExercise.exercise.images.length > 0) { %>
                            <div class="exercise-media-actions" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
                                <button
                                    type="button"
                                    class="btn btn-secondary btn-sm btn-open-images"
                                    data-images="<%- JSON.stringify(sessionExercise.exercise.images).replace(/"/g, '&quot;') %>"
                                    style="display:inline-flex; align-items:center; gap:6px;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                    Ver foto<%= sessionExercise.exercise.images.length > 1 ? 's' : '' %>
                                </button>
                            </div>
                        <% } %>
                    </div>
                    <button class="btn-complete" data-session-id="<%= session.id %>" data-exercise-id="<%= sessionExercise.id %>"
                            data-last-weight="<%= sessionExercise.actualWeight || sessionExercise.lastWeight || '' %>"
                            data-last-reps="<%= sessionExercise.actualReps || sessionExercise.lastReps || '' %>">
                        <span class="check-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>
                        <span class="check-text">Concluído</span>
                    </button>
                </div>
            </div>
        <% }); %>
    </div>

    <!-- Complete Workout Button -->
    <div class="complete-section" id="completeSection">
        <label class="feedback-label" for="workoutFeedback">Como foi o treino? (opcional)</label>
        <textarea id="workoutFeedback" class="feedback-textarea" rows="2" placeholder="Ex: senti bem cansado nas pernas hoje..."></textarea>
        <button id="completeWorkoutBtn" class="btn btn-primary btn-lg">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Finalizar Treino
        </button>
    </div>

    <div id="loadModal" class="load-modal-backdrop" style="display:none;">
        <div class="load-modal-card">
            <h3 id="loadModalExerciseName">Registrar treino</h3>
            <div class="load-modal-field">
                <label for="loadModalWeight">Carga</label>
                <input type="text" id="loadModalWeight" placeholder="ex: 20kg">
            </div>
            <div class="load-modal-field">
                <label for="loadModalReps">Repetições</label>
                <input type="text" id="loadModalReps" placeholder="ex: 12,10,8">
            </div>
            <div class="load-modal-actions">
                <button type="button" id="loadModalSkip" class="btn btn-secondary btn-sm">Pular</button>
                <button type="button" id="loadModalConfirm" class="btn btn-primary btn-sm">Confirmar</button>
            </div>
        </div>
    </div>

    <div id="exerciseImageModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:9999;padding:24px;align-items:center;justify-content:center;">
        <div style="position:relative;max-width:900px;width:100%;max-height:100%;display:flex;flex-direction:column;gap:12px;">
            <button type="button" id="closeExerciseImageModal" class="btn btn-secondary btn-sm" style="align-self:flex-end;">Fechar</button>
            <div style="background:#111;border-radius:14px;padding:12px;display:flex;align-items:center;justify-content:center;min-height:240px;">
                <img id="exerciseImageModalPreview" src="" alt="Imagem do exercício" style="max-width:100%;max-height:65vh;border-radius:10px;object-fit:contain;display:none;">
            </div>
            <div id="exerciseImageModalThumbs" style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;"></div>
        </div>
    </div>
</div>

<script nonce="<%= nonce %>">
    const sessionId = '<%= session.id %>';
    const csrfToken = '<%= csrfToken %>';
    const totalExercises = <%= totalCount %>;
    let completedCount = <%= completedCount %>;
    const sessionStartedAt = '<%= session.startedAt %>';

    const loadModal = document.getElementById('loadModal');
    const loadModalExerciseName = document.getElementById('loadModalExerciseName');
    const loadModalWeight = document.getElementById('loadModalWeight');
    const loadModalReps = document.getElementById('loadModalReps');
    let pendingExercise = null;

    function openLoadModal(btn, exerciseName) {
        pendingExercise = btn;
        loadModalExerciseName.textContent = exerciseName;
        loadModalWeight.value = btn.dataset.lastWeight || '';
        loadModalReps.value = btn.dataset.lastReps || '';
        loadModal.style.display = 'flex';
        loadModalWeight.focus();
    }

    function closeLoadModal() {
        loadModal.style.display = 'none';
        pendingExercise = null;
    }

    document.getElementById('loadModalSkip').addEventListener('click', () => {
        if (pendingExercise) submitExerciseComplete(pendingExercise, null, null);
        closeLoadModal();
    });

    document.getElementById('loadModalConfirm').addEventListener('click', () => {
        if (pendingExercise) submitExerciseComplete(pendingExercise, loadModalWeight.value.trim() || null, loadModalReps.value.trim() || null);
        closeLoadModal();
    });

    loadModal.addEventListener('click', (event) => {
        if (event.target === loadModal) closeLoadModal();
    });

    const imageModal = document.getElementById('exerciseImageModal');
    const imageModalPreview = document.getElementById('exerciseImageModalPreview');
    const imageModalThumbs = document.getElementById('exerciseImageModalThumbs');

    // Complete Exercise
    document.querySelectorAll('.btn-complete').forEach(btn => {
        // If already completed, disable button on load
        const exerciseItem = document.querySelector(`[data-exercise-id="${btn.dataset.exerciseId}"]`);
        if (exerciseItem && exerciseItem.classList.contains('completed')) {
            btn.disabled = true;
        }

        btn.addEventListener('click', function() {
            const exerciseItem = document.querySelector(`[data-exercise-id="${this.dataset.exerciseId}"]`);
            const exerciseName = exerciseItem?.querySelector('.exercise-info h3')?.textContent || 'Exercício';
            openLoadModal(this, exerciseName);
        });
    });

    async function submitExerciseComplete(btn, actualWeight, actualReps) {
        const sessionId = btn.dataset.sessionId;
        const exerciseId = btn.dataset.exerciseId;
        const exerciseItem = document.querySelector(`[data-exercise-id="${exerciseId}"]`);

        try {
            btn.disabled = true;

            const response = await fetch(`/workouts/session/${sessionId}/exercise/${exerciseId}/complete`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ actualWeight, actualReps })
            });

            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const data = await response.json();

            if (data.success) {
                exerciseItem.classList.add('completed');
                completedCount++;
                document.getElementById('progressText').textContent = `${completedCount}/${totalExercises} exercícios`;
                document.getElementById('progressPercent').textContent = `${Math.round((completedCount / totalExercises) * 100)}%`;
                document.getElementById('progressFill').style.width = `${(completedCount / totalExercises) * 100}%`;

                if (completedCount === totalExercises) {
                    document.getElementById('completeSection').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    showToast('Exercício concluído!', 'success');
                }
            } else {
                throw new Error(data.message || 'Erro desconhecido');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Erro: ' + error.message, 'error');
            btn.disabled = false;
        }
    }

    async function finishWorkout() {
        try {
            const durationMin = Math.max(1, Math.round((Date.now() - new Date(sessionStartedAt).getTime()) / 60000));
            const notes = document.getElementById('workoutFeedback')?.value.trim() || null;
            const response = await fetch(`/workouts/session/${sessionId}/complete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ durationMin, notes })
            });

            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const data = await response.json();

            if (data.success) {
                setTimeout(() => window.location.href = '/workouts', 1800);
            } else {
                throw new Error(data.message || 'Erro ao finalizar');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('Erro ao finalizar: ' + error.message, 'error');
            document.getElementById('completeWorkoutBtn').disabled = false;
        }
    }

    // Pode finalizar a qualquer momento; se faltar exercício, pede confirmação
    document.getElementById('completeWorkoutBtn')?.addEventListener('click', async function() {
        const pending = totalExercises - completedCount;
        if (pending > 0) {
            const msg = `Você concluiu ${completedCount} de ${totalExercises} exercícios. ` +
                `${pending === 1 ? 'O exercício restante ficará marcado' : `Os ${pending} restantes ficarão marcados`} como não feito. Finalizar mesmo assim?`;
            if (!(await askConfirm(msg, 'Finalizar treino'))) return;
        }
        this.disabled = true;
        await finishWorkout();
    });

    function openExerciseImageModal(images) {
        if (!Array.isArray(images) || images.length === 0) {
            return;
        }

        imageModal.style.display = 'flex';
        renderExerciseImageGallery(images, 0);
    }

    function renderExerciseImageGallery(images, activeIndex) {
        const current = images[activeIndex];
        if (!current) {
            return;
        }

        imageModalPreview.src = current.publicUrl;
        imageModalPreview.alt = current.fileName || 'Imagem do exercício';
        imageModalPreview.style.display = 'block';

        imageModalThumbs.innerHTML = images.map((image, index) => {
            const activeStyle = index === activeIndex
                ? 'border:2px solid var(--accent-primary);opacity:1;'
                : 'border:2px solid transparent;opacity:.75;';

            return `<button type="button" class="btn-thumb-image" data-index="${index}" style="padding:0;border-radius:8px;overflow:hidden;background:transparent;${activeStyle}">
                <img src="${image.publicUrl}" alt="${image.fileName || 'Imagem'}" style="width:72px;height:72px;object-fit:cover;display:block;">
            </button>`;
        }).join('');

        imageModalThumbs.querySelectorAll('.btn-thumb-image').forEach((button) => {
            button.addEventListener('click', () => {
                renderExerciseImageGallery(images, Number(button.dataset.index));
            });
        });
    }

    document.querySelectorAll('.btn-open-images').forEach((button) => {
        button.addEventListener('click', () => {
            const images = JSON.parse(button.dataset.images || '[]');
            openExerciseImageModal(images);
        });
    });

    document.getElementById('closeExerciseImageModal')?.addEventListener('click', () => {
        imageModal.style.display = 'none';
        imageModalPreview.src = '';
        imageModalThumbs.innerHTML = '';
    });

    imageModal?.addEventListener('click', (event) => {
        if (event.target === imageModal) {
            imageModal.style.display = 'none';
            imageModalPreview.src = '';
            imageModalThumbs.innerHTML = '';
        }
    });
</script>
