<meta name="csrf-token" content="<%= csrfToken %>">

<% const templatePlans = plans.filter(p => p.isTemplate); const assignedPlans = plans.filter(p => !p.isTemplate); %>

<div class="plans-page">

    <div class="page-header" style="display:flex; align-items:center; gap:14px; border-bottom:1px solid var(--border-subtle);">
        <span style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-muted); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        <div style="flex:1;">
            <h1 style="margin-bottom:2px;">Gerenciar Planos</h1>
            <p class="page-subtitle">Templates da biblioteca e planos já atribuídos a alunos</p>
        </div>
        <% if (isAdmin) { %>
        <button class="btn btn-primary" id="btn-novo-plano" onclick="toggleCreatePanel()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo Plano
        </button>
        <% } %>
    </div>

    <!-- Inline: Criar Plano -->
    <% if (isAdmin) { %>
    <div class="inline-panel" id="panel-create">
        <div class="inline-panel-header">
            <span class="inline-panel-title">Novo Plano</span>
            <button class="modal-close" onclick="toggleCreatePanel()" title="Fechar">&times;</button>
        </div>
        <form onsubmit="submitCreate(event)" class="inline-panel-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
                <label>Nome *</label>
                <input type="text" id="c-name" name="name" placeholder="ex: Peito e Costas" required>
            </div>
            <div class="form-group">
                <label>Descricao</label>
                <textarea id="c-desc" name="description" rows="2" placeholder="Objetivo do plano..."></textarea>
            </div>
            <div class="inline-panel-actions">
                <button type="submit" class="btn btn-primary" id="btn-create">Criar Plano</button>
                <button type="button" class="btn btn-secondary" onclick="toggleCreatePanel()">Cancelar</button>
            </div>
        </form>
    </div>
    <% } %>

    <% if (plans.length > 0) { %>
        <!-- Templates da Biblioteca -->
        <% if (templatePlans.length > 0) { %>
            <div class="section-card-header">
                <div class="section-card-title">
                    <span class="section-icon-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </span>
                    <h2>Templates da Biblioteca</h2>
                </div>
            </div>
            <span class="section-hint">Podem ser atribuídos a qualquer aluno. Editar aqui não afeta quem já recebeu uma cópia.</span>
            <div class="plans-simple-list" id="plans-list-templates" style="margin-bottom:28px;">
                <% templatePlans.forEach(plan => { %>
                    <%- include('_plan-row', { plan: plan, isAdmin: isAdmin, csrfToken: csrfToken }) %>
                <% }); %>
            </div>
        <% } %>

        <!-- Planos Atribuídos -->
        <% if (assignedPlans.length > 0) { %>
            <div class="section-card-header">
                <div class="section-card-title">
                    <span class="section-icon-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <h2>Planos Atribuídos</h2>
                </div>
            </div>
            <span class="section-hint">Cópias individuais já em uso por um aluno (inclui você, se atribuiu um plano a si mesmo).</span>
            <div class="plans-simple-list" id="plans-list-assigned">
                <% assignedPlans.forEach(plan => { %>
                    <%- include('_plan-row', { plan: plan, isAdmin: isAdmin, csrfToken: csrfToken }) %>
                <% }); %>
            </div>
        <% } %>
    <% } else { %>
        <div class="empty-state" id="empty-state">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block; margin:0 auto 14px; opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <p>Nenhum plano criado ainda</p>
            <small>Crie seu primeiro plano de treino</small>
            <button class="btn btn-primary" onclick="toggleCreatePanel()">Criar Plano</button>
        </div>
    <% } %>

</div>

<script nonce="<%= nonce %>">
const _csrf = document.querySelector('meta[name="csrf-token"]').content;

// --- Toast ---
function toast(msg, type = 'info') {
    let c = document.querySelector('.toast-container');
    if (!c) { c = document.createElement('div'); c.className = 'toast-container'; document.body.appendChild(c); }
    const t = document.createElement('div');
    t.className = 'toast toast-' + type;
    t.textContent = msg;
    c.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 3500);
}

// --- Criar Plano (inline panel) ---
function toggleCreatePanel() {
    const panel = document.getElementById('panel-create');
    const isOpen = panel.classList.toggle('open');
    if (isOpen) {
        panel.querySelector('form').reset();
        document.getElementById('c-name').focus();
    }
}

async function submitCreate(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const btn = document.getElementById('btn-create');
    btn.disabled = true; btn.textContent = 'Criando...';
    try {
        const r = await fetch('/workouts/plans', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
            body: JSON.stringify({ name: fd.get('name'), description: fd.get('description') || null })
        });
        const d = await r.json();
        if (d.success) { toast('Plano criado!', 'success'); setTimeout(() => location.reload(), 1200); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Criar Plano'; }
}

// --- Painel de Grupos Musculares (inline accordion) ---
let _openGroupsPanelId = null;

function toggleGroupsPanel(planId) {
    const panel = document.getElementById('groups-panel-' + planId);
    const editBtn = document.getElementById('btn-edit-' + planId);

    // Fechar painel anterior se diferente
    if (_openGroupsPanelId && _openGroupsPanelId !== planId) {
        const prev = document.getElementById('groups-panel-' + _openGroupsPanelId);
        const prevBtn = document.getElementById('btn-edit-' + _openGroupsPanelId);
        if (prev) prev.classList.remove('open');
        if (prevBtn) prevBtn.textContent = 'Editar';
        _openGroupsPanelId = null;
    }

    const isOpen = panel.classList.toggle('open');
    if (isOpen) {
        editBtn.textContent = 'Fechar';
        _openGroupsPanelId = planId;
    } else {
        editBtn.textContent = 'Editar';
        _openGroupsPanelId = null;
    }
}

// --- Grupo Muscular: criar ---
function toggleAddGroupForm(planId) {
    const form = document.getElementById('add-group-form-' + planId);
    const isOpen = form.style.display === 'none' || !form.style.display;
    form.style.display = isOpen ? 'block' : 'none';
    if (isOpen) form.querySelector('[name="name"]').focus();
}

async function submitAddGroup(e, planId) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const btn = e.target.querySelector('[type="submit"]');
    btn.disabled = true;
    try {
        const r = await fetch('/workouts/plans/' + planId + '/groups', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
            body: JSON.stringify({ name: fd.get('name') })
        });
        const d = await r.json();
        if (d.success) { toast('Grupo muscular criado!', 'success'); setTimeout(() => location.reload(), 800); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
    finally { btn.disabled = false; }
}

// --- Grupo Muscular: renomear ---
async function renameGroup(groupId) {
    const el = document.getElementById('group-name-' + groupId);
    const newName = prompt('Novo nome do grupo muscular:', el.textContent.trim());
    if (!newName || !newName.trim()) return;
    try {
        const r = await fetch('/workouts/groups/' + groupId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
            body: JSON.stringify({ name: newName.trim() })
        });
        const d = await r.json();
        if (d.success) { el.textContent = d.group.name; toast('Grupo renomeado!', 'success'); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
}

// --- Grupo Muscular: remover ---
async function deleteGroup(groupId, planId, name) {
    if (!confirm('Remover o grupo "' + name + '"? Os exercicios dele serao removidos.')) return;
    try {
        const r = await fetch('/workouts/groups/' + groupId, { method: 'DELETE', headers: { 'X-CSRF-Token': _csrf } });
        const d = await r.json();
        if (d.success) { toast('Grupo removido!', 'success'); setTimeout(() => location.reload(), 800); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
}

// --- Painel de Exercicios de um grupo muscular (inline accordion) ---
let _openExPanelId = null;

function toggleGroupExercises(groupId) {
    const panel = document.getElementById('group-ex-panel-' + groupId);
    const toggleBtn = document.getElementById('btn-toggle-group-' + groupId);

    // Fechar painel anterior se diferente
    if (_openExPanelId && _openExPanelId !== groupId) {
        const prev = document.getElementById('group-ex-panel-' + _openExPanelId);
        const prevBtn = document.getElementById('btn-toggle-group-' + _openExPanelId);
        if (prev) prev.classList.remove('open');
        if (prevBtn) prevBtn.textContent = 'Exercícios';
        _openExPanelId = null;
    }

    const isOpen = panel.classList.toggle('open');
    if (isOpen) {
        toggleBtn.textContent = 'Fechar';
        _openExPanelId = groupId;
        loadExercises(groupId);
    } else {
        toggleBtn.textContent = 'Exercícios';
        _openExPanelId = null;
    }
}

// --- Deletar Plano ---
async function deletePlan(id, name) {
    if (!confirm('Deletar "' + name + '"? Os exercicios serao removidos.')) return;
    try {
        const r = await fetch('/workouts/plans/' + id, { method: 'DELETE', headers: { 'X-CSRF-Token': _csrf } });
        const d = await r.json();
        if (d.success) { toast('Plano deletado!', 'success'); setTimeout(() => location.reload(), 1000); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
}

async function toggleTemplate(id, btn) {
    try {
        const r = await fetch('/workouts/plans/' + id + '/toggle-template', { method: 'PATCH', headers: { 'X-CSRF-Token': _csrf } });
        const d = await r.json();
        if (d.success) {
            toast(d.isTemplate ? 'Plano movido para a biblioteca!' : 'Plano removido da biblioteca', 'success');
            setTimeout(() => location.reload(), 800);
        } else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
}

// --- Listar Exercicios ---
async function loadExercises(groupId) {
    const list = document.getElementById('ex-list-' + groupId);
    list.innerHTML = '<p class="exercises-loading">Carregando...</p>';
    try {
        const r = await fetch('/workouts/groups/' + groupId + '/exercises');
        const d = await r.json();
        if (!d.success || d.exercises.length === 0) {
            list.innerHTML = '<p class="no-exercises-msg">Nenhum exercicio ainda</p>';
            return;
        }
        list.innerHTML = d.exercises.map(function(ex, i) {
            return '<div class="exercise-row" id="exrow-' + ex.id + '">' +
                '<div class="exercise-row-number">' + (i+1) + '</div>' +
                '<div class="exercise-row-info">' +
                    '<span class="exercise-row-name">' + escHtml(ex.name) + '</span>' +
                    '<div class="exercise-row-meta">' +
                        '<span class="meta-pill">' + escHtml(ex.sets) + 'x' + escHtml(ex.reps) + '</span>' +
                        (ex.weight ? '<span class="meta-pill">' + escHtml(ex.weight) + '</span>' : '') +
                        (ex.restSeconds ? '<span class="meta-pill">' + escHtml(ex.restSeconds) + 's</span>' : '') +
                        (ex.notes ? '<span class="meta-pill meta-notes">' + escHtml(ex.notes) + '</span>' : '') +
                    '</div>' +
                '</div>' +
                '<div class="exercise-row-actions">' +
                    '<button class="btn-icon" onclick="uploadExImage(' + ex.id + ',' + groupId + ', true)" title="Tirar foto">' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>' +
                    '</button>' +
                    '<button class="btn-icon" onclick="uploadExImage(' + ex.id + ',' + groupId + ', false)" title="Anexar imagem">' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>' +
                    '</button>' +
                    '<button class="btn-icon" onclick="showExEditForm(' + ex.id + ',' + groupId + ',\'' + esc(ex.name) + '\',' + ex.sets + ',\'' + esc(ex.reps) + '\',\'' + esc(ex.weight||'') + '\',' + (ex.restSeconds||0) + ',\'' + esc(ex.notes||'') + '\')" title="Editar">' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>' +
                    '</button>' +
                    '<button class="btn-icon btn-icon-danger" onclick="deleteEx(' + ex.id + ',' + groupId + ',\'' + esc(ex.name) + '\')" title="Deletar">' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>' +
                    '</button>' +
                '</div>' +
            '</div>' +
            '<div id="eximg-' + ex.id + '" style="display:flex;flex-wrap:wrap;gap:8px;padding:8px 0 2px 42px;"></div>';
        }).join('');

        d.exercises.forEach(function(ex) {
            loadExerciseImages(ex.id);
        });
    } catch(_) { list.innerHTML = '<p class="error-msg">Erro ao carregar</p>'; }
}

function esc(s) { return String(s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }
function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// --- Upload de Imagem de Exercicio ---
function uploadExImage(exerciseId, groupId, useCamera) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    if (useCamera) {
        input.setAttribute('capture', 'environment');
    }
    input.onchange = async function () {
        const file = input.files && input.files[0];
        if (!file) return;

        const fd = new FormData();
        fd.append('image', file);

        try {
            const r = await fetch('/workouts/exercises/' + exerciseId + '/images', {
                method: 'POST',
                headers: { 'X-CSRF-Token': _csrf, 'Accept': 'application/json' },
                body: fd,
            });

            const d = await r.json().catch(function () {
                return { success: false, message: 'Falha ao interpretar resposta do upload.' };
            });
            if (d.success) {
                toast('Imagem enviada com sucesso!', 'success');
                loadExerciseImages(exerciseId);
            } else {
                toast(d.message || 'Falha no upload da imagem', 'error');
            }
        } catch (_) {
            toast('Erro de conexao no upload', 'error');
        }
    };
    input.click();
}

function fmtSize(bytes) {
    if (!bytes && bytes !== 0) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

async function loadExerciseImages(exerciseId) {
    const box = document.getElementById('eximg-' + exerciseId);
    if (!box) return;

    try {
        const r = await fetch('/workouts/exercises/' + exerciseId + '/images');
        const d = await r.json();

        if (!d.success || !d.images || d.images.length === 0) {
            box.innerHTML = '';
            return;
        }

        box.innerHTML = d.images.map(function(img) {
            const name = escHtml(img.fileName || 'imagem');
            const size = fmtSize(img.sizeBytes);
            return '<div style="border:1px solid rgba(255,255,255,0.14);border-radius:8px;padding:6px;background:rgba(255,255,255,0.02);width:122px;">' +
                '<img src="' + escHtml(img.publicUrl) + '" alt="' + name + '" style="width:108px;height:78px;object-fit:cover;border-radius:6px;display:block;margin:0 auto 6px;">' +
                '<div style="font-size:10px;line-height:1.25;min-height:24px;word-break:break-word;">' + name + '</div>' +
                '<div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;opacity:.8;margin-top:4px;">' +
                    '<span>' + size + '</span>' +
                    '<button class="btn-icon btn-icon-danger" onclick="deleteExImage(' + exerciseId + ',' + img.id + ')" title="Excluir imagem">' +
                        '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>' +
                    '</button>' +
                '</div>' +
            '</div>';
        }).join('');
    } catch (_) {
        box.innerHTML = '';
    }
}

async function deleteExImage(exerciseId, imageId) {
    if (!confirm('Excluir esta imagem?')) return;
    try {
        const r = await fetch('/workouts/exercises/' + exerciseId + '/images/' + imageId, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': _csrf, 'Accept': 'application/json' }
        });
        const d = await r.json();
        if (d.success) {
            toast('Imagem removida!', 'success');
            loadExerciseImages(exerciseId);
        } else {
            toast(d.message || 'Falha ao remover imagem', 'error');
        }
    } catch (_) {
        toast('Erro ao remover imagem', 'error');
    }
}

// --- Editar Exercicio (inline) ---
function showExEditForm(id, groupId, name, sets, reps, weight, rest, notes) {
    const row = document.getElementById('exrow-' + id);
    row.innerHTML =
        '<form class="exercise-inline-edit" onsubmit="saveExInline(event,' + id + ',' + groupId + ')">' +
            '<div class="inline-edit-grid">' +
                '<input class="inline-input inline-input-wide" type="text" name="name" value="' + escHtml(name) + '" placeholder="Nome" required>' +
                '<input class="inline-input" type="number" name="sets" value="' + sets + '" min="1" max="20" placeholder="Series" required>' +
                '<input class="inline-input" type="text" name="reps" value="' + escHtml(reps) + '" placeholder="Reps" required>' +
                '<input class="inline-input" type="text" name="weight" value="' + escHtml(weight) + '" placeholder="Carga">' +
                '<input class="inline-input" type="number" name="restSeconds" value="' + (rest||'') + '" placeholder="Desc(s)">' +
                '<input class="inline-input inline-input-wide" type="text" name="notes" value="' + escHtml(notes) + '" placeholder="Notas">' +
            '</div>' +
            '<div class="inline-edit-actions">' +
                '<button type="submit" class="btn btn-primary btn-sm">Salvar</button>' +
                '<button type="button" class="btn btn-secondary btn-sm" onclick="loadExercises(' + groupId + ')">Cancelar</button>' +
            '</div>' +
        '</form>';
    row.querySelector('[name="name"]').focus();
}

async function saveExInline(e, id, groupId) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const btn = e.target.querySelector('[type="submit"]');
    btn.disabled = true; btn.textContent = 'Salvando...';
    const body = {
        name: fd.get('name'),
        sets: fd.get('sets'),
        reps: fd.get('reps'),
        weight: fd.get('weight') || null,
        restSeconds: fd.get('restSeconds') || null,
        notes: fd.get('notes') || null
    };
    try {
        const r = await fetch('/workouts/exercises/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf }, body: JSON.stringify(body) });
        const d = await r.json();
        if (d.success) { toast('Exercicio atualizado!', 'success'); loadExercises(groupId); }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Salvar'; }
}

// --- Adicionar Exercicio ---
function toggleAddEx(groupId) {
    const form = document.getElementById('add-form-' + groupId);
    const isOpen = form.style.display === 'none' || !form.style.display;
    form.style.display = isOpen ? 'block' : 'none';
    if (isOpen) form.querySelector('[name="name"]').focus();
}

async function submitAddEx(e, groupId) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const btn = e.target.querySelector('[type="submit"]');
    btn.disabled = true;
    try {
        const r = await fetch('/workouts/groups/' + groupId + '/exercises', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
            body: JSON.stringify({ name: fd.get('name'), sets: fd.get('sets'), reps: fd.get('reps'), weight: fd.get('weight')||null, restSeconds: fd.get('restSeconds')||null, notes: fd.get('notes')||null })
        });
        const d = await r.json();
        if (d.success) {
            const cameraImage = fd.get('cameraImage');
            const galleryImage = fd.get('galleryImage');

            if (cameraImage && cameraImage.size > 0) {
                await uploadExerciseImageFile(d.exercise.id, cameraImage);
            }

            if (galleryImage && galleryImage.size > 0) {
                await uploadExerciseImageFile(d.exercise.id, galleryImage);
            }

            toast('Exercicio adicionado!', 'success');
            e.target.reset();
            document.getElementById('add-form-' + groupId).style.display = 'none';
            loadExercises(groupId);
            const badge = document.getElementById('group-excnt-' + groupId);
            if (badge) { const n = (parseInt(badge.textContent) || 0) + 1; badge.textContent = n + ' exerc.'; }
        } else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
    finally { btn.disabled = false; }
}

async function uploadExerciseImageFile(exerciseId, file) {
    const imageForm = new FormData();
    imageForm.append('image', file);

    const response = await fetch('/workouts/exercises/' + exerciseId + '/images', {
        method: 'POST',
        headers: { 'X-CSRF-Token': _csrf, 'Accept': 'application/json' },
        body: imageForm,
    });

    const data = await response.json().catch(function () {
        return { success: false, message: 'Falha ao interpretar resposta do upload.' };
    });
    if (!data.success) {
        throw new Error(data.message || 'Falha no upload da imagem');
    }
}

// --- Deletar Exercicio ---
async function deleteEx(id, groupId, name) {
    if (!confirm('Deletar "' + name + '"?')) return;
    try {
        const r = await fetch('/workouts/exercises/' + id, { method: 'DELETE', headers: { 'X-CSRF-Token': _csrf, 'Accept': 'application/json' } });
        const d = await r.json();
        if (d.success) {
            toast('Deletado!', 'success');
            loadExercises(groupId);
            const badge = document.getElementById('group-excnt-' + groupId);
            if (badge) { const n = Math.max(0, (parseInt(badge.textContent) || 1) - 1); badge.textContent = n + ' exerc.'; }
        }
        else toast(d.message || 'Erro', 'error');
    } catch(_) { toast('Erro de conexao', 'error'); }
}
</script>
